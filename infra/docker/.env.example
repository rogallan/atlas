# ==============================================================================
# ATLAS Banking Copilot — Local Docker Stack Environment Configuration (S20)
# Copy this file to .env or infra/docker/.env to customize local ports and models.
# ==============================================================================

# --- Port Mappings (Host -> Container) ---
GATEWAY_PORT=8000
OLLAMA_PORT=11434
VECTOR_DB_PORT=6333
FRONTEND_PORT=5173

# --- Core Service Hostnames (Docker Bridge Network: atlas-network) ---
OLLAMA_HOST=http://ollama:11434
VECTOR_DB_HOST=vector-db
VECTOR_DB_PORT=6333

# --- LLM & Embedding Model Defaults ---
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Application Runtime & Observability ---
ENVIRONMENT=local-docker
LOG_LEVEL=INFO

# --- Frontend & CORS Configuration ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
